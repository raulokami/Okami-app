// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo minimo de la Fase 1, solo para verificar que la
// conexion a la base de datos funciona end-to-end.
model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
}

// Fase 2: auth con Clerk (Organizations + roles de membresia).
// Los ids de Organization y User son los ids de Clerk (org_... / user_...),
// no cuid — asi el sync Clerk -> Prisma es un upsert directo por id.
// Los modelos de negocio (Athlete, Membership, Week, etc.) se añaden
// en fases posteriores segun OKAMI_APP_SPEC_v2.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id             String   @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  OWNER
  COACH
  ATHLETE
}
