// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo minimo de la Fase 1, solo para verificar que la
// conexion a la base de datos funciona end-to-end.
model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
}

// Fase 2: auth con Clerk (Organizations + roles de membresia).
// Los ids de Organization y User son los ids de Clerk (org_... / user_...),
// no cuid — asi el sync Clerk -> Prisma es un upsert directo por id.
// Los modelos de pagos (Membership) y progresion/vistas de atleta se
// añaden en fases posteriores segun OKAMI_APP_SPEC_v2.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  athletes Athlete[]
  weeks    Week[]
}

model User {
  id             String   @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  OWNER
  COACH
  ATHLETE
}

// Fase 3: CRUD Athletes + Weeks, sin pagos (Membership llega en fase 6)
// ni generacion de PDF real (el microservicio se conecta en fase 4 y
// rellena Week.pdfUrl / pasa status a GENERATED).
model Athlete {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  format         Format
  jotformData    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  weeks Week[]

  @@index([organizationId])
}

model Week {
  id             String       @id @default(cuid())
  athleteId      String?
  athlete        Athlete?     @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  format         Format
  subformato     String?
  semana         String
  rawText        String
  pdfUrl         String?
  status         WeekStatus   @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pdf WeekPdf?

  @@index([organizationId])
  @@index([athleteId])
}

// Bytes del PDF generado, separados de Week para que la tabla caliente
// no cargue con blobs. Un solo registro por Week (upsert al regenerar,
// nunca se acumulan versiones) y se borra en cascada con la Week.
model WeekPdf {
  weekId    String   @id
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String   @default("application/pdf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Format {
  CLASE_METCON
  CLASE_ENDURANCE
  ATLETA
  HYBRID
  RECOMPOSICION
  SISTEMA_INDIVIDUAL
  HYROX_INDIVIDUAL
}

enum WeekStatus {
  DRAFT
  GENERATED
  SENT
}
